 "dialogues": [
  {
   "id": "bg-d-kafene",
   "level": "A1",
   "icon": "☕",
   "title": {
    "en": "A café in Sofia",
    "de": "Ein Café in Sofia",
    "fr": "Un café à Sofia",
    "es": "Un café en Sofía"
   },
   "situation": {
    "en": "You sit down in a café on Vitosha Boulevard.",
    "de": "Du setzt dich in ein Café am Witoscha-Boulevard.",
    "fr": "Tu t'assois dans un café du boulevard Vitocha.",
    "es": "Te sientas en un café del bulevar Vitosha."
   },
   "speakers": {
    "servitorka": {
     "name": "Сервитьорка",
     "accessory": "martenitsa"
    },
    "ti": {
     "name": "Ти",
     "accessory": "martenitsa"
    }
   },
   "lines": [
    {
     "speaker": "servitorka",
     "text": "Добър ден! Какво ще желаете?",
     "translations": {
      "en": "Good afternoon! What would you like?",
      "de": "Guten Tag! Was möchten Sie?",
      "fr": "Bonjour ! Que désirez-vous ?",
      "es": "¡Buenas tardes! ¿Qué desea?"
     }
    },
    {
     "speaker": "ti",
     "text": "",
     "translations": {},
     "choices": [
      {
       "text": "Добър ден! Едно кафе, моля.",
       "translations": {
        "en": "Good afternoon! A coffee, please.",
        "de": "Guten Tag! Einen Kaffee, bitte.",
        "fr": "Bonjour ! Un café, s'il vous plaît.",
        "es": "¡Buenas tardes! Un café, por favor."
       },
       "correct": true
      },
      {
       "text": "Довиждане!",
       "translations": {
        "en": "Goodbye!",
        "de": "Auf Wiedersehen!",
        "fr": "Au revoir !",
        "es": "¡Adiós!"
       },
       "correct": false,
       "feedback": {
        "en": "You just sat down!",
        "de": "Du hast dich gerade erst hingesetzt!",
        "fr": "Tu viens de t'asseoir !",
        "es": "¡Acabas de sentarte!"
       }
      }
     ]
    },
    {
     "speaker": "servitorka",
     "text": "А нещо за хапване? Имаме баница.",
     "translations": {
      "en": "And something to eat? We have banitsa.",
      "de": "Und etwas zu essen? Wir haben Baniza.",
      "fr": "Et quelque chose à manger ? Nous avons de la banitsa.",
      "es": "¿Y algo de comer? Tenemos banitsa."
     }
    },
    {
     "speaker": "ti",
     "text": "",
     "translations": {},
     "choices": [
      {
       "text": "Да, една баница, благодаря.",
       "translations": {
        "en": "Yes, one banitsa, thank you.",
        "de": "Ja, eine Baniza, danke.",
        "fr": "Oui, une banitsa, merci.",
        "es": "Sí, una banitsa, gracias."
       },
       "correct": true
      },
      {
       "text": "Казвам се Ана.",
       "translations": {
        "en": "My name is Ana.",
        "de": "Ich heiße Ana.",
        "fr": "Je m'appelle Ana.",
        "es": "Me llamo Ana."
       },
       "correct": false,
       "feedback": {
        "en": "She asked about food!",
        "de": "Sie hat nach Essen gefragt!",
        "fr": "Elle parlait de nourriture !",
        "es": "¡Te preguntó por la comida!"
       }
      }
     ]
    },
    {
     "speaker": "servitorka",
     "text": "Заповядайте! Добър апетит!",
     "translations": {
      "en": "Here you are! Enjoy your meal!",
      "de": "Bitte schön! Guten Appetit!",
      "fr": "Voilà ! Bon appétit !",
      "es": "¡Aquí tiene! ¡Buen provecho!"
     }
    },
    {
     "speaker": "ti",
     "text": "",
     "translations": {},
     "choices": [
      {
       "text": "Благодаря! Сметката, моля.",
       "translations": {
        "en": "Thank you! The bill, please.",
        "de": "Danke! Die Rechnung, bitte.",
        "fr": "Merci ! L'addition, s'il vous plaît.",
        "es": "¡Gracias! La cuenta, por favor."
       },
       "correct": true
      },
      {
       "text": "Наздраве!",
       "translations": {
        "en": "Cheers!",
        "de": "Prost!",
        "fr": "Santé !",
        "es": "¡Salud!"
       },
       "correct": false,
       "feedback": {
        "en": "That's for drinks with friends, not for coffee with the waitress.",
        "de": "Das sagt man beim Anstoßen mit Freunden, nicht beim Kaffee mit der Kellnerin.",
        "fr": "C'est pour trinquer entre amis, pas pour un café avec la serveuse.",
        "es": "Eso es para brindar con amigos, no para un café con la camarera."
       }
      }
     ]
    },
    {
     "speaker": "servitorka",
     "text": "Пет лева. Приятен ден!",
     "translations": {
      "en": "Five leva. Have a nice day!",
      "de": "Fünf Lewa. Schönen Tag noch!",
      "fr": "Cinq levs. Bonne journée !",
      "es": "Cinco levas. ¡Que tenga un buen día!"
     }
    }
   ]
  }
 ],
 "readings": [
  {
   "id": "bg-r-sofia",
   "section": "core",
   "level": "A1",
   "title": {
    "en": "Sofia",
    "de": "Sofia",
    "fr": "Sofia",
    "es": "Sofía"
   },
   "sentences": [
    {
     "text": "София е столицата на България.",
     "translations": {
      "en": "Sofia is the capital of Bulgaria.",
      "de": "Sofia ist die Hauptstadt Bulgariens.",
      "fr": "Sofia est la capitale de la Bulgarie.",
      "es": "Sofía es la capital de Bulgaria."
     }
    },
    {
     "text": "Градът е стар, но млад.",
     "translations": {
      "en": "The city is old but young.",
      "de": "Die Stadt ist alt, aber jung.",
      "fr": "La ville est vieille mais jeune.",
      "es": "La ciudad es vieja pero joven."
     }
    },
    {
     "text": "До София има голяма планина – Витоша.",
     "translations": {
      "en": "Next to Sofia there is a big mountain: Vitosha.",
      "de": "Neben Sofia gibt es einen großen Berg: Witoscha.",
      "fr": "À côté de Sofia, il y a une grande montagne : Vitocha.",
      "es": "Junto a Sofía hay una gran montaña: Vitosha."
     }
    },
    {
     "text": "Хората пият кафе и ядат баница сутрин.",
     "translations": {
      "en": "People drink coffee and eat banitsa in the morning.",
      "de": "Die Leute trinken morgens Kaffee und essen Baniza.",
      "fr": "Le matin, les gens boivent du café et mangent de la banitsa.",
      "es": "Por la mañana la gente toma café y come banitsa."
     }
    },
    {
     "text": "Вечер приятелите казват „Наздраве!“.",
     "translations": {
      "en": "In the evening friends say “Cheers!”.",
      "de": "Abends sagen Freunde „Prost!“.",
      "fr": "Le soir, les amis disent « Santé ! ».",
      "es": "Por la noche los amigos dicen «¡Salud!»."
     }
    }
   ],
