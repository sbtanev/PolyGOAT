  "grammarNotes": [
    { "id": "es-g-ser-intro", "level": "A1",
      "title": { "en": "“Soy” = I am", "bg": "„Soy“ = аз съм" },
      "body": {
        "en": "**soy** means *I am*. Spanish usually drops the word for *I* (yo), because the verb already shows who is speaking: **Soy de Bulgaria** = I am from Bulgaria.",
        "bg": "**soy** означава *аз съм*. Испанският обикновено изпуска *аз* (yo), както и българският, защото глаголът вече показва кой говори: **Soy de Bulgaria** = (Аз) съм от България."
      } }
  ],
  "cultureNotes": [
    { "id": "es-c-two-kisses",
      "title": { "en": "Two kisses", "bg": "Две целувки" },
      "body": { "en": "In Spain friends and new acquaintances often greet with two light kisses on the cheeks (right first). In much of Latin America it's one.", "bg": "В Испания приятели и нови познати често се поздравяват с две леки целувки по бузите (първо дясната). В голяма част от Латинска Америка е една." } }
  ],
